# install.sh generates this file for you. Copy it by hand only for custom setups.
# Every setting below "Optional" has a sensible default and can be left out.

# --- Required -----------------------------------------------------------------
AUTH_SECRET="replace-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
POSTGRES_PASSWORD="change-me-postgres-password"

# --- Web ----------------------------------------------------------------------
APP_PORT="3003"
# Leave empty to accept any hostname (localhost, LAN IP, domain).
# Set it when the dashboard sits behind a reverse proxy, e.g. https://ops.example.com
AUTH_URL=""

# --- Local development only (npm run dev); Docker Compose sets this itself -----
DATABASE_URL="postgresql://devsecops:change-me-postgres-password@localhost:5433/devsecops_dashboard?schema=public"

# --- Optional -----------------------------------------------------------------
# COMPOSE_PROJECT_NAME="devsecopsdash"
# COMPOSE_FILE="docker-compose.yml:docker-compose.docker-socket.yml"  # enables container management
# DOCKER_SOCKET_GID=""
# DASHBOARD_IMAGE="ghcr.io/claritys11/devsecops-dashboard:latest"

# Allow monitoring 10.x / 172.16-31.x / 192.168.x / localhost. Cloud metadata stays blocked.
MONITOR_ALLOW_PRIVATE_NETWORKS="false"

# Agent for the machine running the dashboard (install.sh fills these in).
PRIMARY_SERVER_NAME=""
PRIMARY_AGENT_ID=""
PRIMARY_AGENT_TOKEN=""

# Alert thresholds
# ALERT_CPU_CRITICAL_PERCENT="90"
# ALERT_MEMORY_CRITICAL_PERCENT="90"
# ALERT_DISK_CRITICAL_PERCENT="85"
# ALERT_SSL_EXPIRING_DAYS="14"
# ALERT_ENDPOINT_FAILURE_THRESHOLD="3"
# AGENT_STALE_AFTER_MINUTES="2"
# SERVER_OFFLINE_AFTER_MINUTES="10"

# Retention and worker tuning
# METRICS_RETENTION_DAYS="30"
# MONITOR_WORKER_POLL_SECONDS="15"
# MONITOR_WORKER_BATCH_SIZE="10"
# MONITORING_DEFAULT_TIMEOUT_MS="5000"

# Startup behaviour
# RUN_DATABASE_MIGRATIONS="true"
# RUN_DATABASE_SEED="true"          # idempotent bootstrap (admin + pre-provisioned agents)
# ADMIN_RESET_PASSWORD="false"      # true = reset the admin password to ADMIN_PASSWORD on start
# SEED_ENDPOINTS_JSON='[{"name":"Example","url":"https://example.com"}]'
