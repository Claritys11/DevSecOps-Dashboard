POSTGRES_DB="devsecops_dashboard"
POSTGRES_USER="devsecops"
POSTGRES_PASSWORD="change-me-postgres-password"
DATABASE_URL="postgresql://devsecops:change-me-postgres-password@localhost:5433/devsecops_dashboard?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3003"
APP_PORT="3003"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
RUN_DATABASE_MIGRATIONS="true"
RUN_DATABASE_SEED="false"
SEED_HOMELAB_EXAMPLES="false"
SEED_ENDPOINTS_JSON=""
ENABLE_DOCKER_SOCKET="false"
DOCKER_SOCKET_PATH=""
UBUNTU_NSPAWN_DOCKER_ENDPOINT=""
DASHBOARD_HEALTH_URL="http://host.docker.internal:3003/api/health"
COOLIFY_STATUS_URL="http://host.docker.internal:8000"
MONITORING_DEFAULT_TIMEOUT_MS="5000"
MONITOR_WORKER_POLL_SECONDS="15"
MONITOR_WORKER_LOCK_SECONDS="45"
MONITOR_WORKER_BATCH_SIZE="10"
MONITOR_ALLOW_PRIVATE_NETWORKS="false"
MONITOR_REDIRECT_LIMIT="3"
METRICS_RETENTION_DAYS="30"
ALERT_CPU_CRITICAL_PERCENT="90"
ALERT_MEMORY_CRITICAL_PERCENT="90"
ALERT_DISK_CRITICAL_PERCENT="85"
ALERT_SSL_EXPIRING_DAYS="14"
ALERT_ENDPOINT_FAILURE_THRESHOLD="3"
AGENT_STALE_AFTER_MINUTES="2"
SERVER_OFFLINE_AFTER_MINUTES="10"
AGENT_MAX_CLOCK_SKEW_SECONDS="300"
AGENT_NONCE_RETENTION_MINUTES="30"
AGENT_MAX_BODY_BYTES="16384"
PRIMARY_AGENT_ID="primary-linux-agent"
PRIMARY_AGENT_TOKEN="change-me-agent-token"
SECONDARY_AGENT_ID=""
SECONDARY_AGENT_TOKEN=""
